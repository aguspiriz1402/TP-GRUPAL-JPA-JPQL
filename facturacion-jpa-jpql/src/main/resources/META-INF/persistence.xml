<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd"
             version="2.2">
    <persistence-unit name="FacturacionPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>ar.edu.prog3.facturacion.modelo.Usuario</class>
        <class>ar.edu.prog3.facturacion.modelo.FacturaVenta</class>
        <class>ar.edu.prog3.facturacion.modelo.FacturaVentaDetalle</class>
        <class>ar.edu.prog3.facturacion.modelo.PuntoVenta</class>
        <class>ar.edu.prog3.facturacion.modelo.TipoMoneda</class>
        <class>ar.edu.prog3.facturacion.modelo.Cliente</class>
        <class>ar.edu.prog3.facturacion.modelo.CondicionIva</class>
        <class>ar.edu.prog3.facturacion.modelo.Contacto</class>
        <class>ar.edu.prog3.facturacion.modelo.Domicilio</class>
        <class>ar.edu.prog3.facturacion.modelo.ListaPrecioArticulo</class>
        <class>ar.edu.prog3.facturacion.modelo.Articulo</class>
        <class>ar.edu.prog3.facturacion.modelo.ListaPrecio</class>
        <class>ar.edu.prog3.facturacion.modelo.Marca</class>
        <class>ar.edu.prog3.facturacion.modelo.Rubro</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="javax.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="javax.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/facturacion"/>
            <property name="javax.persistence.jdbc.user" value="facturacion"/>
            <!-- Main toma la clave de DB_PASSWORD; no se guardan credenciales reales. -->
            <property name="javax.persistence.jdbc.password" value=""/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQL10Dialect"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
        </properties>
    </persistence-unit>
</persistence>
